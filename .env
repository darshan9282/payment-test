PORT=3000
NODE_ENV=development
MONGO_URI=

# Retry config
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000

# Circuit breaker
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_MS=30000
CB_HALF_OPEN_MAX_CALLS=2

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Gateway simulation
GATEWAY_SUCCESS_RATE=0.7
GATEWAY_TIMEOUT_RATE=0.1
GATEWAY_MIN_DELAY_MS=100
GATEWAY_MAX_DELAY_MS=2000
GATEWAY_TIMEOUT_MS=5000

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400
